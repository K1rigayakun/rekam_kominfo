# ─── SERVER ───────────────────────────────
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# ─── DATABASE ─────────────────────────────
# Pastikan GANTI_PASSWORD diubah sesuai database production!
DATABASE_URL=postgresql://rekam_app:GANTI_PASSWORD@localhost:5432/rekam_prod

# ─── REDIS ────────────────────────────────
REDIS_URL=redis://:GANTI_REDIS_PASSWORD@localhost:6379

# ─── MINIO (Object Storage) ────────────────
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=rekam_minio_admin
MINIO_SECRET_KEY=GANTI_MINIO_PASSWORD_MIN16CHAR
MINIO_BUCKET_RAW=rekam-raw
MINIO_BUCKET_PROCESSED=rekam-processed
MINIO_BUCKET_ATTACH=rekam-attach
MINIO_BUCKET_EXPORTS=rekam-exports

# ─── AUTH ─────────────────────────────────
# Wajib diganti dengan karakter acak 64 karakter (bisa pakai `openssl rand -hex 64`)
JWT_ACCESS_SECRET=GANTI_DENGAN_SECRET_KEY_YANG_SANGAT_PANJANG_UNTUK_PRODUCTION
JWT_REFRESH_SECRET=GANTI_DENGAN_SECRET_KEY_YANG_SANGAT_PANJANG_YANG_BERBEDA
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ─── APP ──────────────────────────────────
APP_BASE_URL=https://rekam.kominfo.co.id
PUBLIC_BASE_URL=https://rekam.kominfo.co.id
EXPORT_TTL_HOURS=24

# ─── FFMPEG ───────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ─── BULL QUEUE ───────────────────────────
MEDIA_PROCESSING_CONCURRENCY=2

# ─── RATE LIMITING ────────────────────────
RATE_LIMIT_PUBLIC_MAX=200
RATE_LIMIT_PUBLIC_WINDOW_MS=3600000

# ─── LOGGING ──────────────────────────────
LOG_LEVEL=info
