# Copy to apps/backend/.env and replace placeholders before running.

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>

# Redis. Use redis://:<REDIS_PASSWORD>@localhost:6379 when Redis auth is enabled.
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379

# MinIO object storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=<MINIO_ROOT_USER>
MINIO_SECRET_KEY=<MINIO_ROOT_PASSWORD>
MINIO_BUCKET_RAW=rekam-raw
MINIO_BUCKET_PROCESSED=rekam-processed
MINIO_BUCKET_ATTACH=rekam-attach
MINIO_BUCKET_EXPORTS=rekam-exports

# Auth. Generate production values with: openssl rand -hex 64
JWT_ACCESS_SECRET=<GENERATE_RANDOM_64_HEX>
JWT_REFRESH_SECRET=<GENERATE_RANDOM_64_HEX>
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Upload
TUS_STORE_PATH=./tmp/tus-store
MAX_UPLOAD_SIZE_BYTES=0
CHUNK_SIZE_DEFAULT_BYTES=5242880

# App URLs
APP_BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:5173
EXPORT_TTL_HOURS=24

# Media processing
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Rate limiting
RATE_LIMIT_PUBLIC_MAX=200
RATE_LIMIT_PUBLIC_WINDOW_MS=3600000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=600000

# Logging
LOG_LEVEL=debug
